# Copy to `.env` and fill in your machine's values.
# Find these on your machine's CONNECT tab in the Viam app (app.viam.com).
# Load them into your shell before running, e.g.:  set -a; source .env; set +a

VIAM_API_KEY=
VIAM_API_KEY_ID=
VIAM_MACHINE_ADDRESS=

# Optional: dial the machine directly instead of relaying through the cloud.
# Set this when running on the device that hosts viam-server (use
# localhost:8080, its default bind address) or elsewhere on its LAN (use the
# machine's local address from the CONNECT tab). Always include the port.
# Takes precedence over VIAM_MACHINE_ADDRESS. Direct connections deliver large
# payloads like depth frames intact, which WebRTC does not always manage.
VIAM_LOCAL_ADDRESS=

# Set to 1 only if a local connection fails with InsecureConnectionError,
# meaning viam-server is not serving TLS at that address.
VIAM_LOCAL_INSECURE=0

# Resource names as configured on your machine (defaults shown).
VIAM_ARM_NAME=arm
VIAM_GRIPPER_NAME=gripper
VIAM_MOTION_NAME=builtin
